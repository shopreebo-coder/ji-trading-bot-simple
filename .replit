modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Telemetry Dashboard"

[[workflows.workflow]]
name = "Telemetry Dashboard"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8083 SHADOW_LAB_RESEARCH=on KNOWLEDGE_LAYER=on SELECTED_ENGINE=on SELECTED_ADVISOR=on TELEMETRY_RECONCILER=on node telemetry/server.js"
waitForPort = 8083

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3002

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 3001

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 80

[userenv]

[userenv.shared]
MAX_OPEN_TRADES = "3"
TRAILING_MIN_AGE_SECONDS = "60"
TRAILING_MIN_PROFIT_PIPS = "2.0"
TRAILING_MIN_SL_IMPROVEMENT_PIPS = "0.5"
TRAILING_SL_BUFFER_PIPS = "0.2"
COOP_ENTRY_ENABLED = "on"
KNOWLEDGE_LAYER = "on"
SELECTED_ADVISOR = "on"
SELECTED_ENGINE = "on"
SHADOW_LAB_RESEARCH = "on"
SHADOW_OS_MEMORY = "on"
TELEMETRY_RECONCILER = "on"
OANDA_ENV = "live"
OANDA_ENVIRONMENT = "live"

[nix]
channel = "stable-25_05"
